<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpooderInstallerSharp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:icon="https://github.com/projektanker/icons.avalonia"
		xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:views="clr-namespace:SpooderInstallerSharp.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SpooderInstallerSharp.Views.MainWindow"
		x:DataType="vm:MainViewModel"
		SizeChanged="OnSizeChanged">
	<UserControl.Styles>
		<Style Selector="ToggleButton:checked">
			<Setter Property="Background" Value="DarkGreen"/>
		</Style>
		<Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="DarkGreen"/>
		</Style>
		<Style Selector="ToggleButton:checked:pointerover">
			<Setter Property="Background" Value="LimeGreen"/>
		</Style>
		<Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="LimeGreen"/>
		</Style>
		<Style Selector="Border.spin">
			<Setter Property="RenderTransform">
				<RotateTransform/>
			</Setter>
			<Style.Animations>
				<Animation Duration="0:0:1" IterationCount="INFINITE">
					<KeyFrame Cue="0%">
						<Setter Property="RotateTransform.Angle" Value="0.0"/>
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="RotateTransform.Angle" Value="360.0"/>
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</UserControl.Styles>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border x:Name="MainBorder" Padding="10" >
		<StackPanel Orientation="Vertical" x:Name="MainHeaderGrid" Spacing="10">

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Spooder Name" x:Name="SpooderName" FontFamily="{StaticResource RecursiveFont}" FontSize="24"
					   HorizontalAlignment="Left" VerticalAlignment="Center"
					   Grid.Row="0" Grid.Column="0"/>
				<StackPanel x:Name="SpooderPet" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
							Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
					<TextBlock Text="/╲" x:Name="longlegleft" FontSize="36" />
					<TextBlock Text="/\" x:Name="shortlegleft" FontSize="36"/>
					<TextBlock Text="(" x:Name="bodyleft" FontSize="36"/>
					<TextBlock Text="º" x:Name="littleeyeleft" FontSize="36"/>
					<ContentControl Name="bigeyeleftcontrol">
						<TextBlock Text="o" x:Name="bigeyeleft" FontSize="36"/>
					</ContentControl>
					<TextBlock Text=" " x:Name="fangleft" FontSize="36"/>
					<TextBlock Text="ω" x:Name="mouth" FontSize="36"/>
					<TextBlock Text=" " x:Name="fangright" FontSize="36"/>
					<ContentControl Name="bigeyerightcontrol">
						<TextBlock Text="o" x:Name="bigeyeright" FontSize="36"/>
					</ContentControl>
					<TextBlock Text="º" x:Name="littleeyeright" FontSize="36"/>
					<TextBlock Text=")" x:Name="bodyright" FontSize="36"/>
					<TextBlock Text="/\" x:Name="shortlegright" FontSize="36"/>
					<TextBlock Text="╱\" x:Name="longlegright" FontSize="36"/>
				</StackPanel>
			</StackPanel>
			<StackPanel x:Name="ControlsGroup" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10"
						Grid.Row="1" Grid.Column="0">
				<Border Name="LoadingIcon" Classes="spin" Width="24" Height="24" VerticalAlignment="Center"
						RenderTransformOrigin="50%,50%"
						IsVisible="{Binding IsLoading}" ToolTip.Tip="Working...">
					<Grid>
						<svg:Svg Path="avares://SpooderInstallerSharp/Assets/DashedCircle.svg" Width="24" Height="24"/>
						<svg:Svg Path="avares://SpooderInstallerSharp/Assets/FilledCircle.svg" Width="12" Height="12"
								 HorizontalAlignment="Center" VerticalAlignment="Center"
								 IsVisible="{Binding IsSpooderBusy}"/>
					</Grid>
				</Border>
				<views:ProcessControls x:Name="ProcessControls" DataContext="{Binding}" />
				<ToggleButton Name="SettingsButton" icon:Attached.Icon="fa-spin fa-gear" FontSize="24" Click="OnSettingsClick" ToolTip.Tip="Manager Settings">

				</ToggleButton>
			</StackPanel>
		</StackPanel>
		</Border>
		<Border x:Name="ContentBorder" BorderThickness="5" Padding="10" Grid.Row="1">
			<ContentControl x:Name="ContentFrame"/>
		</Border>
	</Grid>
</UserControl>
