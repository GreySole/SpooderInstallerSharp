    </ItemGroup>

    <PropertyGroup>
        <ExtractedFileCount>@(ExtractedFiles->Count())</ExtractedFileCount>
    </PropertyGroup>

    <Message Text="Extraction verification - Files found: $(ExtractedFileCount)" Importance="high" />
    <Message Text="Node.js binary location (Windows): $(NodeJSExtractPath)\node.exe" Importance="high" Condition="'$(DevRuntimeIdentifier)' == 'win-x64'" />
    <Message Text="Node.js binary location (Unix): $(NodeJSExtractPath)/bin/node" Importance="high" Condition="'$(DevRuntimeIdentifier)' != 'win-x64'" />

    <!-- Verify that node.exe was actually extracted -->
    <Message Text="Node.js executable found: $(NodeJSExtractPath)\node.exe" Importance="high" Condition="'$(DevRuntimeIdentifier)' == 'win-x64' AND Exists('$(NodeJSExtractPath)\node.exe')" />
    <Warning Text="Node.js executable NOT found at: $(NodeJSExtractPath)\node.exe" Condition="'$(DevRuntimeIdentifier)' == 'win-x64' AND !Exists('$(NodeJSExtractPath)\node.exe')" />

    <!-- Clean up temporary files -->
    <RemoveDir Directories="$(NodeJSTempExtractPath)" Condition="Exists('$(NodeJSTempExtractPath)')" />
    <Delete Files="$(NodeJSFilePath)" Condition="Exists('$(NodeJSFilePath)')" />

    <Message Text="Node.js extraction completed for development ($(DevRuntimeIdentifier))" Importance="high" />
</Target>

	<!-- Alternative: Include existing nodejs folder if present (for development) -->
	<Target Name="CopyNodeJSForDevelopment" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' == '' AND Exists('nodejs') AND !Exists('$(OutputPath)nodejs\node.exe')">
		<PropertyGroup>
			<NodeJSSourcePath>nodejs</NodeJSSourcePath>
			<NodeJSDestPath>$(OutputPath)nodejs</NodeJSDestPath>
		</PropertyGroup>

		<Message Text="Copying existing Node.js folder for development..." Importance="high" />
		<Message Text="Source: $(NodeJSSourcePath)" Importance="high" />
		<Message Text="Destination: $(NodeJSDestPath)" Importance="high" />

		<!-- Create the destination directory -->
		<MakeDir Directories="$(NodeJSDestPath)" />

		<!-- Copy all nodejs files to output directory -->
		<ItemGroup>
			<NodeJSFiles Include="$(NodeJSSourcePath)\**\*" />
		</ItemGroup>

		<Copy SourceFiles="@(NodeJSFiles)" 
			  DestinationFolder="$(NodeJSDestPath)\%(RecursiveDir)" 
			  SkipUnchangedFiles="true" />

		<Message Text="Node.js files copied successfully for development" Importance="high" />
		<Message Text="Node.js executable available at: $(NodeJSDestPath)\node.exe" Importance="high" />
	</Target>

</Project>