    <!-- Linux extraction -->
    <Exec Command="which xz" Condition="'$(DevRuntimeIdentifier)' == 'linux-x64' AND Exists('$(NodeJSFilePath)')" ContinueOnError="true" IgnoreExitCode="true" />

    <Message Text="Starting Linux extraction..." Importance="high" Condition="'$(DevRuntimeIdentifier)' == 'linux-x64' AND Exists('$(NodeJSFilePath)')" />

    <Exec Command="tar -xJf &quot;$(NodeJSFilePath)&quot; -C &quot;$(NodeJSExtractPath)&quot; --strip-components=1" Condition="'$(DevRuntimeIdentifier)' == 'linux-x64' AND Exists('$(NodeJSFilePath)')" ContinueOnError="false" />

    <Message Text="Linux extraction completed successfully" Importance="high" Condition="'$(DevRuntimeIdentifier)' == 'linux-x64' AND Exists('$(NodeJSFilePath)')" />

    <!-- Verify extraction with safer file counting -->
    <ItemGroup>
        <ExtractedFiles Include="$(NodeJSExtractPath)\**\*" Condition="'$(DevRuntimeIdentifier)' == 'win-x64'" />
