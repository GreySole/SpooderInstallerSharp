<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<AssemblyTitle>Spooder Manager</AssemblyTitle>
	<AssemblyDescription>Spooder Manager Application</AssemblyDescription>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
	<ApplicationIcon>Assets/favicon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Svg.Controls.Avalonia" Version="11.3.0.1" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.0.1" />
    <PackageReference Include="Xaml.Behaviors.Avalonia" Version="11.3.2" />
    <PackageReference Include="Xaml.Behaviors.Interactions" Version="11.3.2" />
    <PackageReference Include="Xaml.Behaviors.Interactivity" Version="11.3.2" />
	<PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpooderInstallerSharp\SpooderInstallerSharp.csproj" />
  </ItemGroup>

	<ItemGroup>
  <!-- Copy nodejs files to output directory for both debug and publish -->
  <Content Include="nodejs\**\*" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
</ItemGroup>

	<ItemGroup>
	  <AvaloniaResource Include="Assets\favicon.ico">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </AvaloniaResource>
	</ItemGroup>

<!-- Ensure .exe files are never bundled during publish -->
<ItemGroup>
  <ExcludeFromSingleFile Include="nodejs\node.exe" />
</ItemGroup>

<!-- Copy node.exe after publish (for single-file deployment compatibility) -->
<Target Name="CopyNodeExeAfterPublish" AfterTargets="Publish">
  <ItemGroup>
    <NodeExe Include="$(MSBuildProjectDirectory)\nodejs\node.exe" />
  </ItemGroup>
  <Copy SourceFiles="@(NodeExe)" DestinationFolder="$(PublishDir)nodejs" SkipUnchangedFiles="true" />
</Target>
</Project>
